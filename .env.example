# Copy this file to .env and replace the placeholders. Never commit .env.
GEMINI_API_KEY=replace-with-a-new-google-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional first-run administrator passwords; set before initializing server/data.json.
LARKY_LEON_PASSWORD=replace-with-a-strong-password
LARKY_YTCOOLCASTER_PASSWORD=replace-with-a-strong-password

# Optional remote AI provider allowlist for Render; use hostnames only, comma-separated.
# LARKY_ALLOWED_AI_HOSTS=your-provider.example.com
