{
  "name": "larky",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "test": "node --test",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
